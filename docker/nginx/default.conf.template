server {
    # Public port. envsubst renders ${PORT} from the environment at container
    # start; NGINX_ENVSUBST_FILTER leaves nginx variables untouched.
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # API and actuator both belong to Spring Boot: the platform health check must
    # reach the JVM, not the static files, and unknown actuator routes must
    # return Spring's 404 instead of the SPA fallback.
    location ~ ^/(api|actuator)/ {
        proxy_pass http://127.0.0.1:${BACKEND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA fallback: /booking and /admin are client-side routes, not files.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
